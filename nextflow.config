report.overwrite = true
timeline.overwrite = true
trace.overwrite = true
conda.enabled = true
docker.enabled = true

// resume = true
cleanup = false

conda.enabled = true

profiles {
    debug {
        params.debug = true
        trace {
            enabled = true
            overwrite = true
            field = 'task_id,native_id,process,name,status,exit,submit,start,complete,duration,realtime'
        }
        timeline {
            enabled = true
            overwrite = true
        }
        report {
            enabled = true
            overwrite = true
        }
        dag {
            enabled = true
            overwrite = true
        }
    }
    local {
        params {
            ref_path = "references"
            outdir = "fiberseq_output"
        }
        process {
            executor = 'local'
            queue = 10
            withLabel: small {
                cpus = 1
                memory = '4GB'
            }
            withLabel: medium {
                cpus = 4
                memory = '8GB'
            }
            withLabel: large {
                cpus = 8
                memory = '16GB'
            }
            withLabel: very_large {
                cpus = 16
                memory = '64GB'
            }
        }
    }
    slurm {
        params {
            ref_path = "references"
            outdir = "fiberseq_output"
        }
        process {
            executor = 'slurm'
            withLabel: small {
                cpus = 1
                memory = '4GB'
            }
            withLabel: medium {
                cpus = 4
                memory = '8GB'
            }
            withLabel: large {
                cpus = 16
                memory = '32GB'
            }
            withLabel: very_large {
                cpus = 32
                memory = '128GB'
            }
        }
    }
}